# Copy this file to ".env" for local development (never commit .env).
# On Vercel, add the same two variables under Project -> Settings -> Environment Variables.

# Supabase -> Connect -> "Transaction pooler" connection string (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Any long random string (keeps login cookies from being forged).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
